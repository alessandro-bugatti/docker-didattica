# Copia questo file in .env e compila i valori.
# Non committare mai il file .env nel repository.

# ------------------------------------------------------------
# Nome progetto
# Usato come prefisso per i container Docker.
# Scegli un nome breve, senza spazi (es: biblioteca, gestionale)
# ------------------------------------------------------------
PROJECT_NAME=scout-prodotti

# ------------------------------------------------------------
# Porte esposte sull'host
# Se hai più progetti attivi contemporaneamente, usa porte diverse
# per ogni progetto (es: 9081, 9082, ... per PORT_HTTP)
# ------------------------------------------------------------
PORT_HTTP=9081
PORT_HTTPS=9444
PORT_DB=3307
PORT_ADMINER=8081

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
MYSQL_HOST=database
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=scout_shop
MYSQL_USER=scout_user
MYSQL_PASSWORD=scout_password

# ------------------------------------------------------------
# Applicazione
# ------------------------------------------------------------
APP_BASE_PATH=
APP_ENV=development
